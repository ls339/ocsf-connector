__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials. The private key is the credential -- it never lives in the repo.
.env
*.pem
*.key
*.jwk
secrets/

# Real configuration. config.example.toml is the tracked template; config.toml
# names a live org and client id, which are tenant identifiers this public repo
# must not carry (CLAUDE.md invariant 5).
config.toml

# Local run state. The -wal and -shm sidecars matter as much as the database:
# the store runs in WAL mode (SPEC §5.3), so they hold uncommitted transactions
# and the shared-memory index -- the same cursor and seen-set data, and just as
# unwelcome in a public repo.
state/*.db
state/*.db-wal
state/*.db-shm
out/

# Terraform. .terraform/ is the downloaded provider (hundreds of megabytes) and
# state can hold the external id the provider roles trust, so neither belongs
# here. .terraform.lock.hcl is deliberately NOT ignored: it pins provider
# hashes, which is the point of having it. *.tfvars names an account id and that
# external id -- the same reasoning as config.toml above -- so the tracked
# template is terraform.tfvars.example.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
.DS_Store
.claude/settings.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Per-machine bd activity log. bd appends to it on every command, so tracking it
# dirties the tree constantly and conflicts on merge. Kept here rather than in
# .beads/.gitignore, which bd manages and may regenerate.
.beads/interactions.jsonl
