__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials. The private key is the credential -- it never lives in the repo.
.env
*.pem
*.key
*.jwk
secrets/

# Real configuration. config.example.toml is the tracked template; config.toml
# names a live org and client id, which are tenant identifiers this public repo
# must not carry (CLAUDE.md invariant 5).
config.toml

# Local run state
state/*.db
out/
.terraform/
*.tfstate
*.tfstate.*
.DS_Store
.claude/settings.local.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Per-machine bd activity log. bd appends to it on every command, so tracking it
# dirties the tree constantly and conflicts on merge. Kept here rather than in
# .beads/.gitignore, which bd manages and may regenerate.
.beads/interactions.jsonl
