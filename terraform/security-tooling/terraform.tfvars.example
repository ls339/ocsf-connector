# Copy to terraform.tfvars and fill in. Gitignored: account ids and identity ARNs
# are tenant identifiers, and this repo is public (CLAUDE.md invariant 5).

region      = "us-east-1"
account_id  = "000000000000" # the security-tooling account
aws_profile = "security-tooling"

role_name = "ocsf-connector"

# Who may assume the connector's role. Read your own rather than guessing it --
# an SSO role ARN carries a generated suffix:
#   aws sts get-caller-identity --query Arn --output text
trusted_principals = [
  "arn:aws:iam::000000000000:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_REPLACE_ME",
]

# Empty for the first apply. Fill from `terraform output provider_roles` in
# ../log-archive once the custom sources are registered, then apply again.
provider_role_arns = []
