# Copy to terraform.tfvars and fill in. That file is gitignored: the account id
# and external id are tenant identifiers, and this is a public repo
# (CLAUDE.md invariant 5). The same reasoning as config.toml next door.

region      = "us-east-1"
lake_bucket = "aws-security-data-lake-us-east-1-REPLACE_ME"

# Must equal sink.source_name in the connector's config.toml.
source_name_prefix = "okta"

# The identity the connector runs as, and the secret it presents. The connector
# needs the same external id to assume the per-source provider roles.
provider_principal   = "000000000000"
provider_external_id = "REPLACE_ME_WITH_SOMETHING_UNGUESSABLE"
